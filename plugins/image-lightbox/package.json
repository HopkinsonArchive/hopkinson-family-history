{
  "name": "@hopkinson/image-lightbox",
  "version": "1.0.0",
  "description": "Full-screen lightbox for images embedded in Quartz articles.",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./components": {
      "import": "./dist/components/index.js"
    }
  },
  "main": "./dist/index.js",
  "quartz": {
    "name": "image-lightbox",
    "displayName": "Image Lightbox",
    "category": "component",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {},
    "components": {
      "ImageLightbox": {
        "displayName": "Image Lightbox",
        "defaultPosition": "afterBody",
        "defaultPriority": 100
      }
    }
  }
}